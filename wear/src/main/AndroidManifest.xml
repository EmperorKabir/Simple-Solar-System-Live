<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REQUIRED, direct child of <manifest>: marks this as a Wear OS app and is
         what makes Play treat the artifact as a watch app. -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <!-- Round is the target face, but DO NOT require it (required="true" excludes
         every round watch on Play -> 0 supported devices). -->
    <uses-feature android:name="android.hardware.screen.round" android:required="false" />

    <!-- WFF is RESOURCE-ONLY: no Kotlin/Java, no service, no activity. The watch
         face lives in res/raw/watchface.xml and is rendered by the system WFF
         runtime. hasCode MUST be false. -->
    <application
        android:hasCode="false"
        android:icon="@drawable/ic_solar"
        android:label="@string/watch_face_name"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Watch Face Format runtime version. v1 = Wear OS 4+ (API 33+). The face
             uses only v1 elements, so v1 maximises device compatibility. Must be a
             child of <application>, not <manifest>. -->
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="1" />
    </application>
</manifest>
